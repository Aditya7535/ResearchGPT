# ==============================================================================
# ResearchGPT Configuration
# ==============================================================================

# LLM Backend Provider ("groq" or "ollama")
LLM_PROVIDER=groq

# Groq API Configuration (Free tier: https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama Configuration (For local offline models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Agent Execution Parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Port Configuration
FRONTEND_PORT=80
BACKEND_PORT=8000

# ChromaDB & Storage Paths
CHROMA_PATH=/app/chroma_data
CHROMA_COLLECTION=researchgpt_documents
EXPORT_DIR=/app/exports
